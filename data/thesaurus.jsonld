    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://en.wikipedia.org/wiki/Retrocausality"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/boucle-de-retroaction-positive/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Boucle de rétroaction positive",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "circuit où l’effet renforce sa propre cause : un écart s’amplifie au lieu d’être corrigé.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "rétroaction positive",
     "@language": "fr"
    },
    {
     "@value": "positive feedback",
     "@language": "fr"
    },
    {
     "@value": "cybernétique de l’amplification",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/cyberpositif/#terme"
    },
