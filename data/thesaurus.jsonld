     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/numogramme/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/sorcellerie-temporelle/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/sorcellerie-temporelle/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Sorcellerie temporelle lémurienne",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "dans la mythologie du Ccru, pratique qui traite le temps comme un territoire à cartographier et à pirater, depuis un continent englouti fictif, la Lémurie.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "Lémurie",
     "@language": "fr"
    },
    {
     "@value": "guerre temporelle lémurienne",
     "@language": "fr"
    },
    {
     "@value": "Lemurian Time War",
     "@language": "fr"
    }
   ],
   "skos:broader": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/numogramme/#terme"
   },
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/numogramme/#terme"
    },
