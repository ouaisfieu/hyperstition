  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/hyperstition/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Hyperstition",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "fiction qui contribue à sa propre réalisation : en circulant, elle attire l’attention et les ressources qui la rendent vraie.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "hyper-superstition",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/theorie-fiction/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/prophetie-autorealisatrice/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/boucle-de-retroaction-positive/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/retrocausalite/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/gauche-hyperstitionnelle/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/performativite/#terme"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://en.wikipedia.org/wiki/Hyperstition"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/theorie-fiction/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Théorie-fiction",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "écriture hybride où les concepts prennent la forme de récits, de faux documents et de personnages, et où les récits font un travail conceptuel.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "theory-fiction",
     "@language": "fr"
    },
    {
     "@value": "fiction théorique",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/hyperstition/#terme"
    },
