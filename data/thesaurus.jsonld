    "@value": "Prophétie autoréalisatrice",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "notion de Robert K. Merton (1948) : une définition fausse d’une situation qui provoque un comportement qui la rend vraie.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "self-fulfilling prophecy",
     "@language": "fr"
    },
    {
     "@value": "prédiction créatrice",
     "@language": "fr"
    }
   ],
