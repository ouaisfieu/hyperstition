    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/prophetie-autorealisatrice/#terme"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://en.wikipedia.org/wiki/Positive_feedback"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/cyberpositif/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Cyberpositif",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "néologisme de Sadie Plant et Nick Land : ce qui relève de la rétroaction positive, de l’emballement plutôt que de la régulation.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "cyberpositive",
     "@language": "fr"
    }
   ],
   "skos:broader": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/boucle-de-retroaction-positive/#terme"
   },
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/boucle-de-retroaction-positive/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/accelerationnisme/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/dehors/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Le Dehors",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "chez Land et le Ccru, ce qui échappe à la pensée humaine et à ses catégories : le réel non humain vers lequel poussent la technique et le capital.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "Outside",
     "@language": "fr"
    },
    {
     "@value": "l’Extérieur",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/geotraumatisme/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/teleoplexie/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/geotraumatisme/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Géotraumatisme",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "théorie-fiction du Ccru selon laquelle la Terre est traversée par un traumatisme originel, dont la vie et la pensée seraient des symptômes.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "géotraumatique",
     "@language": "fr"
    },
    {
     "@value": "geotrauma",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/theorie-fiction/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/dehors/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/teleoplexie/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Téléoplexie",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "terme de Nick Land pour la complexification autocatalytique du capital et de la technique, qui s’accélère en poursuivant ses propres fins.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "teleoplexy",
     "@language": "fr"
    }
   ],
   "skos:related": [
