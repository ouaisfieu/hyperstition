    "@value": "Réalisme capitaliste",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "diagnostic de Mark Fisher (2009) : le sentiment diffus qu’aucune alternative au capitalisme n’est même imaginable.",
    "@language": "fr"
