     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/numogramme/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/egregore/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/retrocausalite/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Rétrocausalité",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "causalité apparemment inversée : un état futur semble agir sur le présent parce que sa représentation, elle, agit déjà.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "causalité rétroactive",
     "@language": "fr"
    },
    {
     "@value": "rétro-causalité",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/hyperstition/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/sorcellerie-temporelle/#terme"
    },
