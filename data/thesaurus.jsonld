    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/lumieres-sombres/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/templexite/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Templexité",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "notion de Land (2014) pour les boucles temporelles d’une modernité qui se construit en imitant son propre futur, à partir de l’exemple de Shanghai.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "Templexity",
     "@language": "fr"
    }
   ],
   "skos:related": [
