    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/puissances-du-faux/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/numogramme/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Numogramme",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "diagramme du Ccru qui relie les dix chiffres de 0 à 9 par des paires, des courants et des portes, présenté comme une carte du temps.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "numogramme décimal",
     "@language": "fr"
    },
    {
     "@value": "Numogram",
     "@language": "fr"
    },
    {
     "@value": "labyrinthe décimal",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/syzygie/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/sorcellerie-temporelle/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/qabbale-aq/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/theorie-fiction/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/syzygie/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Syzygie",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "dans le numogramme, paire de zones dont la somme vaut 9 (9::0, 8::1, 7::2, 6::3, 5::4), chacune « portée » par un démon.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "syzygy",
     "@language": "fr"
    }
   ],
   "skos:broader": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/numogramme/#terme"
   },
   "skos:related": [
