    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/xenofeminisme/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/gauche-hyperstitionnelle/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/cyberpositif/#terme"
    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/teleoplexie/#terme"
    }
   ],
   "rdfs:seeAlso": [
    {
     "@id": "https://en.wikipedia.org/wiki/Accelerationism"
    },
    {
     "@id": "https://fr.wikipedia.org/wiki/Acc%C3%A9l%C3%A9rationnisme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/accelerationnisme-efficace/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Accélérationnisme efficace (e/acc)",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "mouvement techno-optimiste né en ligne vers 2022, qui prône l’accélération sans frein de l’IA et de la production d’énergie.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "e/acc",
     "@language": "fr"
    },
    {
     "@value": "effective accelerationism",
     "@language": "fr"
    }
   ],
   "skos:broader": {
