  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/xenofeminisme/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Xénoféminisme",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "féminisme technomatérialiste et antinaturaliste, formulé en 2015 par le collectif Laboria Cuboniks : « si la nature est injuste, changeons la nature ».",
    "@language": "fr"
   },
