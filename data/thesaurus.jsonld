    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/lumieres-sombres/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Lumières sombres",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "courant néoréactionnaire antidémocratique, formulé en ligne autour de Curtis Yarvin et de Nick Land au début des années 2010.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "Dark Enlightenment",
     "@language": "fr"
    },
