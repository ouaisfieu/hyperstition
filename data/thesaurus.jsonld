    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/accelerationnisme/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Accélérationnisme",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "ensemble de positions pour qui il faut intensifier, et non freiner, les processus techniques et économiques du capitalisme, pour le dépasser ou pour le libérer.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "accelerationism",
     "@language": "fr"
    },
    {
     "@value": "acc",
     "@language": "fr"
    }
   ],
   "skos:related": [
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/accelerationnisme-efficace/#terme"
    },
    {
