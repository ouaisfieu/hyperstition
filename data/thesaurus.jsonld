   },
   "skos:definition": {
    "@value": "capacité d’un énoncé ou d’un modèle à faire ce qu’il dit, de la promesse (Austin) aux modèles financiers qui façonnent les marchés (Callon, MacKenzie).",
    "@language": "fr"
   },
   "skos:altLabel": [
