    },
    {
     "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/theorie-fiction/#terme"
    }
   ]
  },
  {
   "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/qabbale-aq/#terme",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://ouaisfieu.github.io/hyperstition/glossaire/#ensemble"
   },
   "skos:prefLabel": {
    "@value": "Qabbale anglaise (AQ)",
    "@language": "fr"
   },
   "skos:definition": {
    "@value": "système numérologique du Ccru qui attribue à chaque caractère sa valeur en base 36 (0-9 puis A = 10 … Z = 35) pour chercher des coïncidences dans l’anglais.",
    "@language": "fr"
   },
   "skos:altLabel": [
    {
     "@value": "AQ",
     "@language": "fr"
    },
    {
     "@value": "Anglossic Qabbala",
     "@language": "fr"
    },
    {
     "@value": "qabbale alphanumérique",
     "@language": "fr"
    }
   ],
   "skos:related": [
